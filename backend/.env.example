# Copy to .env and fill in values you need to override.
# Defaults work for local dev as-is.
#
# Two modes are supported:
#   1. HEURISTIC BASELINE (default): librosa beat tracking, full-mix onsets,
#      centroid-based lane routing. Fast, CPU-only, no extra installs.
#      This is the v1 production path. Every env var below set to 0
#      (or unset) gives you this mode.
#
#   2. ML ENHANCED: Beat This! beat+downbeat detection and/or Demucs
#      stem separation with per-stem onset routing. Higher quality on
#      tempo-shifting / vocal-driven music; needs `pip install '.[ml]'`
#      for Beat This! and `pip install '.[demucs]'` for Demucs.
#
# Toggling between modes is one env var away. Both flags fall back to
# the heuristic path on import/inference failure, so a misconfiguration
# never breaks chart generation - it just silently uses the baseline.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where SQLite cache and temp audio files live.
CACHE_DIR=./cache

# Allow the /charts/generate endpoint to fetch audio via yt-dlp when given a videoId.
# Off by default. Production should keep this off and rely on extension-provided audio.
BACKEND_ALLOW_YTDLP=0

# --- ML toggles (heuristic baseline when all are 0) ---

# Run Demucs source separation as part of the pipeline. When on, onset
# detection runs per-stem (drums + vocals) and lane routing follows the
# stem rather than spectral centroid.
# Off by default. Expensive on CPU (~2-5 min per first-time song; ~15s
# on GPU). Per-stem onsets cached by audio content hash so multiple
# difficulties on the same song only pay Demucs once.
# Requires: pip install -e '.[demucs]'
USE_DEMUCS=0

# Use CPJKU Beat This! (ISMIR 2024 SOTA) for beat + downbeat detection.
# When on, chord stacks fire on real downbeats and the chart carries a
# real bpmCurve. Falls back to librosa on import/inference failure.
# Requires: pip install '.[ml]'
USE_BEAT_THIS=0

# Use MERT audio embeddings (Phase 3) to detect verse/chorus/bridge
# sections. When on, the thinner uses per-section density buckets
# (sharper than the RMS-percentile heuristic) and Chart.sections is
# populated with labeled section records. Falls back to RMS bucketing
# on import/inference failure. MERT-v1-95M is CC-BY-NC (~380MB).
# Requires: pip install '.[mert]'
USE_MERT=0

# --- Production hardening ---

# Maximum simultaneous chart-generate jobs. The pipeline holds the torch
# lock during Demucs/Beat This!/MERT, so additional concurrency on CPU is
# usually wasted. Default 1 is safe for any deploy; bump for GPU boxes
# with headroom.
MAX_CONCURRENT_CHARTS=1

# How long a queued chart-generate request waits before the route 429s.
# Default 0 means fail-fast (return 429 immediately if all slots taken).
# CPU Demucs deploys probably want 0 so clients see "busy" quickly;
# GPU deploys may want 30-60s so a small queue smooths bursts.
CHART_QUEUE_TIMEOUT_S=0

# Max age in days for cache entries (audio downloads, beat/onset/section
# caches, chart-cache rows). Runs on startup; cheap to lower if disk is
# tight, or raise if you want longer-lived caches.
CACHE_MAX_AGE_DAYS=30

# CORS origins allowed to call the API. Comma-separated. Use chrome-extension://<id> in prod.
CORS_ORIGINS=*

# Log level for uvicorn and app loggers.
LOG_LEVEL=info

# OPTIONAL third-party API keys. Leave blank if unused.
# Reserved for future use; the v1 pipeline does not call any external APIs.
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
