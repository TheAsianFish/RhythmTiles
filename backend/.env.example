# Copy to .env and fill in values you need to override.
# Defaults work for local dev as-is.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where SQLite cache and temp audio files live.
CACHE_DIR=./cache

# Allow the /charts/generate endpoint to fetch audio via yt-dlp when given a videoId.
# Off by default. Production should keep this off and rely on extension-provided audio.
BACKEND_ALLOW_YTDLP=0

# Run Demucs source separation as part of the pipeline.
# Off by default. Expensive on CPU. Turn on only if you have a GPU and the time budget.
USE_DEMUCS=0

# CORS origins allowed to call the API. Comma-separated. Use chrome-extension://<id> in prod.
CORS_ORIGINS=*

# Log level for uvicorn and app loggers.
LOG_LEVEL=info

# OPTIONAL third-party API keys. Leave blank if unused.
# Reserved for future use; the v1 pipeline does not call any external APIs.
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
